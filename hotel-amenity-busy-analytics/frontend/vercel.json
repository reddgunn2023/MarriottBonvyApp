{
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/amenities/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/guests/:path*",
      "destination": "/api/index.py"
    }
  ]
}
